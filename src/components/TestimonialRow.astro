---
/**
 * TestimonialRow — PRD F13, §3.5, §6.2.
 *
 * Three at most, each tagged with its treatment so someone weighing All-on-4
 * reads an All-on-4 outcome. The old site's thirty-plus initials-only quotes
 * read as volume standing in for specificity.
 *
 * CSS scroll-snap, not a carousel library: it scrolls with a thumb, with a
 * trackpad, and with the keyboard, ships zero bytes of JavaScript, and on a
 * wide screen it simply stops being a scroller and becomes three columns.
 *
 * Every quote is invented and labelled as such on the card itself, not only in
 * the banner (PRD §2.3).
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  id: string;
  testimonials: CollectionEntry<'testimonials'>[];
  /** Treatment slug → display name, resolved by the page, not looked up here. */
  treatmentNames: Record<string, string>;
}

const { id, testimonials, treatmentNames } = Astro.props;
---

<section id={id} class="u-section" aria-labelledby={`${id}-heading`}>
  <div class="u-container">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2
        id={`${id}-heading`}
        class="text-3xl font-bold text-brand-900 md:text-4xl"
      >
        What treatment is like
      </h2>
      <p class="text-sm text-muted">
        <span class="u-placeholder-tag text-muted">Placeholder</span>
        <span class="ms-2 align-middle">
          Invented copy. No real patient wrote any of this.
        </span>
      </p>
    </div>
  </div>

  <!-- The scroller runs full-bleed so a card can peek at the viewport edge and
       signal that there is more to the right without an arrow button. -->
  <!--
    tabindex="0" because this scrolls horizontally below lg and holds nothing
    focusable: a keyboard-only reader could reach the first card and had no way
    to move the scroller to see the other two (WCAG 2.2 AA 2.1.1). axe's
    scrollable-region-focusable caught it; Lighthouse's accessibility category
    does not run that rule, and scored 100 with the cards unreachable.

    It stays a tab stop at lg, where the row becomes a grid and no longer
    scrolls. One redundant stop on a labelled list is the smaller cost — the
    alternative is a script that adds and removes tabindex on resize, which is
    JavaScript spent on something CSS already handles.
  -->
  <ul
    class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 md:px-8 lg:mx-auto lg:max-w-6xl lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-8"
    style="scrollbar-width: thin;"
    aria-label="Patient stories"
    tabindex="0"
  >
    {
      testimonials.map((entry) => (
        <li class="w-[85vw] shrink-0 snap-start sm:w-[22rem] lg:w-auto">
          <figure class="flex h-full flex-col rounded-xl border border-line bg-paper p-6">
            <span class="self-start rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.06em] text-brand-700">
              {treatmentNames[entry.data.treatmentSlug.id] ??
                entry.data.treatmentSlug.id}
            </span>
            <blockquote class="mt-4 flex-1 text-base leading-relaxed text-ink">
              {entry.data.body}
            </blockquote>
            <figcaption class="mt-5 border-t border-line pt-4 text-sm text-muted">
              {entry.data.attribution}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
