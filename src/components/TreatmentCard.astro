---
/**
 * TreatmentCard — ISLAND, PRD §6.2, §5.1 step 3.
 *
 * Expands an on-page panel rather than navigating away, so the reader keeps
 * their scroll position and their context.
 *
 * The expand/collapse itself is native <details> and costs zero JavaScript;
 * `name` makes the four an exclusive accordion in the browser rather than in
 * a script. What the island actually adds is the three things the platform
 * does not do:
 *
 *   1. writes the open card into the URL, so a half-read page is linkable and
 *      the back button means something;
 *   2. opens the right card when the page is entered on such a URL;
 *   3. records the treatment in the shared store, so the enquiry form arrives
 *      pre-filled (PRD §6.3, §5.1 step 7).
 *
 * With JavaScript off, all three are lost and the card still opens, reads and
 * links to the form. Nothing on this card depends on the script running.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatPrice } from '../lib/format';

interface Props {
  treatment: CollectionEntry<'treatments'>;
  /** Where the panel's call to action points. */
  enquireHref: string;
  /** Exclusive-accordion group. Shared by all four cards. */
  group: string;
}

const { treatment, enquireHref, group } = Astro.props;
const { name, shortDescription, priceFrom, priceCaveat, image } = treatment.data;

/** The anchor the island writes to the URL. Also the card's own id. */
const cardId = `treatment-${treatment.id}`;
const panelId = `${cardId}-panel`;
---

<li>
  <details
    id={cardId}
    name={group}
    class="group h-full overflow-hidden rounded-xl border border-line bg-paper transition-colors open:border-brand-300 hover:border-brand-300"
    data-treatment-card
    data-slug={treatment.id}
  >
    <summary
      class="flex cursor-pointer list-none items-start gap-4 p-5 [&::-webkit-details-marker]:hidden"
    >
      <span class="min-w-0 flex-1">
        <span class="block text-lg font-semibold text-brand-900">{name}</span>
        <span class="mt-1 block text-sm text-muted">{shortDescription}</span>
        <span class="mt-3 block text-sm font-semibold text-brand-700">
          From {formatPrice(priceFrom)}
        </span>
      </span>

      <!-- 44x44 visual target for the affordance, inside a summary whose whole
           box is already clickable (PRD §2.2). -->
      <span
        class="mt-0.5 inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 group-open:bg-brand-100"
      >
        <svg
          class="size-5 transition-transform group-open:rotate-45"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M12 5v14M5 12h14"></path>
        </svg>
        <span class="sr-only">Read more about {name}</span>
      </span>
    </summary>

    <div id={panelId} class="border-t border-line px-5 pb-5 pt-4">
      {/*
        `sizes` is the rendered box, not the viewport. The grid is two columns
        from 768px (never three, so the old 33vw was wrong at every width), the
        container pads 1.25rem and 2rem from 768px, the grid gap is 1rem, and
        the panel itself pads 1.25rem each side. Working that through:

          >= 1152px  container capped at 72rem  ->  (1088 - 16) / 2 - 40 = 496px
          768-1151   two columns                ->  50vw - 80px
          < 768      one column                 ->  100vw - 80px

        Overstating this is what cost the hero 22 KiB in Stage 5.
      */}
      <Image
        src={image.src}
        alt={image.alt}
        widths={[340, 680, 1000]}
        width={1000}
        sizes="(min-width: 1152px) 496px, (min-width: 768px) calc(50vw - 80px), calc(100vw - 80px)"
        loading="lazy"
        decoding="async"
        class="mb-4 aspect-[3/2] w-full rounded-lg border border-line object-cover"
      />

      <!-- detailBody: the Markdown body of the treatment file. -->
      <div class="space-y-3 text-base leading-relaxed text-muted">
        <slot />
      </div>

      <p class="mt-4 rounded-lg bg-brand-50 p-3 text-sm text-brand-800">
        <strong class="font-semibold">From {formatPrice(priceFrom)}.</strong>
        {' '}{priceCaveat}
      </p>

      <!-- Without JavaScript this is a plain jump to the form. With it, the
           form is already set to this treatment by the time you arrive. -->
      <a
        href={enquireHref}
        class="u-btn u-btn-primary mt-4 w-full sm:w-auto"
        data-enquire-about={treatment.id}
      >
        Ask about {name}
      </a>
    </div>
  </details>
</li>

<script>
  import { asTreatmentSlug, setTreatmentInterest } from '../lib/store';

  const cards = document.querySelectorAll<HTMLDetailsElement>('[data-treatment-card]');
  if (cards.length > 0) {
    /**
     * Open the card named in the URL. Browsers already expand a <details> when
     * a fragment lands inside it, but not consistently when the fragment IS the
     * <details>, which is the case here — so do it explicitly.
     */
    const openFromHash = () => {
      const id = location.hash.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (target instanceof HTMLDetailsElement && target.hasAttribute('data-treatment-card')) {
        target.open = true;
      }
    };

    openFromHash();
    window.addEventListener('hashchange', openFromHash);

    for (const card of cards) {
      const slug = asTreatmentSlug(card.dataset.slug);

      card.addEventListener('toggle', () => {
        if (!card.open) return;

        // The reader is looking at this treatment. Both facts follow from that:
        // the URL should say so, and the form should already know.
        if (slug) setTreatmentInterest(slug);

        // replaceState, not a hash assignment: this is a reading position, not
        // a navigation, and it should not stack up in the back button.
        history.replaceState(null, '', `#${card.id}`);
      });
    }

    /**
     * "Ask about X" is a real link to #enquire and works without this. The
     * listener only makes sure the store is written even if the card was
     * already open when the page loaded and never fired a toggle.
     */
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-enquire-about]')) {
      link.addEventListener('click', () => {
        const slug = asTreatmentSlug(link.dataset.enquireAbout);
        if (slug) setTreatmentInterest(slug);
      });
    }
  }
</script>
